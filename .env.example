# The IAM Lab Platform — Environment Variables Example
# Duplicate this file to .env.local for local development.
# In Vercel, set these under Project Settings -> Environment Variables.

# PostgreSQL Connection String (Supabase pooler on port 5432)
# Format: postgresql://[user]:[password]@[host]:5432/[database]
DATABASE_URI="postgresql://payload_app.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres"

# Payload CMS Authentication Secret (generate with: openssl rand -hex 32)
PAYLOAD_SECRET="your-32-byte-secret-token"

# Public Server URL (used by Payload CMS & OpenGraph canonicals)
NEXT_PUBLIC_SERVER_URL="https://www.theiamlab.com"

# Business Notification Recipient
NOTIFY_TO_EMAIL="info@theiamlab.com"

# Webmail SMTP Configuration (Optional, for outbound email via info@theiamlab.com)
SMTP_HOST="smtp.your-webmail-provider.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@theiamlab.com"
SMTP_PASS="your-webmail-password"
