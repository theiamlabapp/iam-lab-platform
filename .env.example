# Webmail SMTP configuration for sending launch notification requests to info@theiamlab.com
# Add these variables in Vercel -> Project Settings -> Environment Variables

SMTP_HOST=smtp.your-webmail-provider.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@theiamlab.com
SMTP_PASS=your-webmail-app-password
NOTIFY_TO_EMAIL=info@theiamlab.com
